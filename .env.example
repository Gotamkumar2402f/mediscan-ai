# ==== LLM ====
GROQ_API_KEY=gsk_your_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ==== Embeddings ====
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# ==== Retrieval ====
RETRIEVE_K=20
RERANK_TOP_N=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120